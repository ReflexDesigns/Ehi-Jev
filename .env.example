# HeyJev - local configuration template
# Development: copy to .env.local in the repo root (loaded only by debug builds).
# Installed app: put the same file in %APPDATA%\com.heyjev.app\.env.local
# Never commit .env.local or put secrets directly in the application bundle.
# Relative paths below resolve against the app resource folder (install dir / target\<profile>).

# Jev / TypeSafe intent classification API
JEV_API_KEY=your_jev_api_key_here
JEV_API_BASE_URL=https://api.typesafe.ai/v1
JEV_MODEL=jev-latest

# OpenRouter (documents with Gemini Flash, projects with DeepSeek Flash).
# Installed app: better paste it in Impostazioni -> Chiave OpenRouter (Windows Credential Manager).
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Optional, private GitHub updater token for import into Windows Credential Manager.
# Fine-grained token: only ReflexDesigns/Ehi-Jev, Contents: read. Do not commit the value.
GH_TOKEN=your_fine_grained_token_here

# Optional path overrides; defaults already point to the bundled models.
# Language, microphone sensitivity and silence timeout live in the app:
# tray icon -> right click -> Impostazioni (saved in %APPDATA%\com.heyjev.app\settings.json).
# WAKE_MODEL_DIR=models/sherpa-onnx-kws-zipformer-gigaspeech-3.3M-2024-01-01
# WHISPER_MODEL_PATH=models/whisper/ggml-tiny.bin
# WHISPER_CPP_BIN=models/whisper/bin/whisper-cli.exe
