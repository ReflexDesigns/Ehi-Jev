# HeyJev - local configuration template
# Copy this file to .env.local, then fill in your private values.
# Never commit .env.local or put secrets directly in the application bundle.

# Jev / TypeSafe intent classification API
JEV_API_KEY=your_jev_api_key_here
JEV_API_BASE_URL=https://api.typesafe.ai/v1
JEV_MODEL=jev-latest

# sherpa-onnx English wake-word model directory (prepared by scripts/setup-kws.ps1)
WAKE_MODEL_DIR=./models/sherpa-onnx-kws-zipformer-gigaspeech-3.3M-2024-01-01

# Local whisper.cpp speech recognition
WHISPER_MODEL_PATH=./models/whisper-tiny.bin
WHISPER_CPP_BIN=whisper-cli.exe
WHISPER_LANGUAGE=auto

# Vite development server port
APP_PORT=3000
