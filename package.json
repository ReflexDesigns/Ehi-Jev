{
  "name": "heyjev",
  "private": true,
  "version": "0.2.7",
  "type": "module",
  "description": "HeyJev - Direttore Operativo Vocale del PC (The Notch)",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 3000 --strictPort",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "icons": "tauri icon ./public/app-icon.svg --output src-tauri/icons",
    "setup:kws": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/setup-kws.ps1",
    "setup:whisper": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/setup-whisper.ps1",
    "setup:models": "npm run setup:kws && npm run setup:whisper",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "test": "node scripts/check-parser.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.1.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.1.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
