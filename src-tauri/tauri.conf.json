{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "HeyJev",
  "version": "0.2.5",
  "identifier": "com.heyjev.app",
  "build": {
    "beforeDevCommand": "npm run setup:models && npm run dev",
    "devUrl": "http://127.0.0.1:3000",
    "beforeBuildCommand": "npm run setup:models && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "HeyJev",
        "width": 640,
        "height": 380,
        "minWidth": 640,
        "maxWidth": 640,
        "minHeight": 380,
        "maxHeight": 380,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "resizable": false,
        "skipTaskbar": true,
        "visible": true,
        "focus": false,
        "center": true,
        "shadow": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: data: blob:; media-src 'self' blob:; connect-src 'self' ipc: http://ipc.localhost; worker-src 'self' blob:"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": [
      "nsis"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Italian",
          "English"
        ],
        "installerHooks": "./windows/hooks.nsh"
      }
    },
    "resources": {
      "../models/sherpa-onnx-kws-zipformer-gigaspeech-3.3M-2024-01-01/*-left-64.onnx": "models/sherpa-onnx-kws-zipformer-gigaspeech-3.3M-2024-01-01/",
      "../models/sherpa-onnx-kws-zipformer-gigaspeech-3.3M-2024-01-01/tokens.txt": "models/sherpa-onnx-kws-zipformer-gigaspeech-3.3M-2024-01-01/tokens.txt",
      "../models/sherpa-onnx-kws-zipformer-gigaspeech-3.3M-2024-01-01/keywords.txt": "models/sherpa-onnx-kws-zipformer-gigaspeech-3.3M-2024-01-01/keywords.txt",
      "../models/whisper/ggml-tiny.bin": "models/whisper/ggml-tiny.bin",
      "../models/whisper/bin/*": "models/whisper/bin/"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDM4MDFEOUE2MjVGNjlFQjAKUldTd252WWxwdGtCT01pdEtCZVJlSFpjd3pFZTVkazR0d0Q5N3pFNTNPYjhxSmplSzRMbTdHd1AK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
